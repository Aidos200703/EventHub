# PostgreSQL connection string (docker compose up -d starts a matching database)
DATABASE_URL="postgresql://eventhub:eventhub@localhost:5433/eventhub"

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"
# Public origin of the app (auth callbacks, absolute URLs in metadata)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shows the "Try demo account" buttons on the sign-in page. Set to "false" in real deployments.
NEXT_PUBLIC_DEMO_MODE="true"
# Password used by the seed script for demo accounts
DEMO_PASSWORD="eventhub-demo"
